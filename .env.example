# Bot token from Discord Developer Portal -> Bot -> Reset Token
DISCORD_TOKEN=

# Application ID (Developer Portal -> General Information)
CLIENT_ID=

# OAuth2 client secret (Developer Portal -> OAuth2 -> Reset Secret)
# Required for the admin web interface
CLIENT_SECRET=

# Optional but recommended: register slash commands to this guild (instant)
GUILD_ID=

# Optional: path to the FAQ config file (defaults to config/faq.json)
CONFIG_PATH=config/faq.json

# Optional: port for the admin web interface (defaults to 3000)
ADMIN_PORT=3000

# Optional: callback URL for Discord OAuth (defaults to http://localhost:PORT/auth/callback)
# Set this to https://bot.zephex.dk/auth/callback for production
ADMIN_CALLBACK_URL=

# Optional: session secret for admin auth (auto-generated if not set)
SESSION_SECRET=

# Set to 1 for verbose gateway logging
DEBUG=